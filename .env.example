# Since the ".env" file is gitignored, you can use this ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to ".env".
#
# This file will be committed to version control, so make sure not to have any
# secrets in it. When cloning this repo, create a copy of this file named
# ".env" and populate it with your values.
#
# When adding new environment variables, update the schema in "src/env.ts"
# accordingly.

# Server-side variables (never exposed to the client)
SERVER_URL=

# Client-side variables (must be prefixed with VITE_; bundled into the client,
# so never put secrets here)
VITE_APP_TITLE=

# Canonical public origin every absolute URL is minted from (OAuth client_id,
# publication URLs, head tags). Leave empty to use the default hosted origin.
# SELF-HOSTERS: set this to your own public origin, e.g.
#   VITE_PUBLIC_ORIGIN=https://your-worker.your-subdomain.workers.dev
# so minted URLs and your OAuth client identity point at your deployment.
VITE_PUBLIC_ORIGIN=

# PostHog — one project serves dev, preview AND production; every event is
# stamped with an `app_env` property (hostname-derived), and insights filter
# app_env=production by default. Put the real key in your local `.env` too;
# leaving it empty disables analytics entirely (empty string counts as unset).
# Production/preview builds get both from the Workers Builds build variables.
VITE_PUBLIC_POSTHOG_KEY=
# Optional; defaults to https://us.i.posthog.com
VITE_PUBLIC_POSTHOG_HOST=
