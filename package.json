{
  "name": "goldroad",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "scripts": {
    "build": "vite build",
    "check": "biome check .",
    "check:unsafe": "biome check --write --unsafe .",
    "gate": "pnpm check --error-on-warnings && pnpm typecheck && pnpm test",
    "check:write": "biome check --write .",
    "dev": "vite dev --port 3000",
    "format": "biome format",
    "lint": "biome lint",
    "prepare": "husky",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm run build && wrangler deploy --config dist/server/wrangler.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply goldroad-db --local",
    "db:migrate:selfhost": "wrangler d1 migrations apply goldroad-db --remote",
    "db:migrate:prod": "wrangler d1 migrations apply goldroad-db --remote --env production",
    "cf:types": "wrangler types",
    "release": "node scripts/release.mjs",
    "db:migrate:staging": "wrangler d1 migrations apply goldroad-db-staging --remote --env staging"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.4",
    "@atcute/client": "^5.1.2",
    "@atcute/identity-resolver": "^2.0.3",
    "@atcute/lexicons": "^2.1.1",
    "@atcute/oauth-node-client": "^2.0.1",
    "@atcute/standard-site": "^2.0.2",
    "@blocknote/core": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@blocknote/shadcn": "^0.56.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@t3-oss/env-core": "^0.13.11",
    "@tabler/icons-react": "^3.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "posthog-js": "^1.440.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "packageManager": "pnpm@12.16.1",
  "license": "AGPL-3.0-only"
}
