# Workers secrets for local dev. Copy to `.dev.vars` (gitignored) and fill in.
# Keep the KEYS here in sync: `pnpm cf:types` derives the Env type from .dev.vars.
#
# OAuth dev note: on localhost the app runs as an atproto LOOPBACK public
# client (RFC 8252) — redirect URIs must use 127.0.0.1, so browse the dev app
# at http://127.0.0.1:3000 (not localhost) or the session cookie lands on the
# wrong host.

# HMAC key for the session cookie signature: `openssl rand -hex 32`
COOKIE_SECRET=

# ES256 private JWK for private_key_jwt client assertions. LEAVE EMPTY in dev
# (loopback public clients have no keys). In prod this is a wrangler secret:
#   node --input-type=module -e "import { generateClientAssertionKey } from '@atcute/oauth-node-client'; console.log(JSON.stringify(await generateClientAssertionKey('main','ES256')))" \
#     | pnpm wrangler secret put OAUTH_PRIVATE_KEY_JWK
OAUTH_PRIVATE_KEY_JWK=""

# OPTIONAL alert webhook for the hourly cron self-check (audit #6). When set,
# the scheduled handler POSTs core-invariant failures here (Slack/Discord/etc.);
# absent = alerting is a silent no-op. In prod set it as a wrangler secret:
#   echo "https://hooks.example/…" | pnpm wrangler secret put WEBHOOK_URL
WEBHOOK_URL=""

# OPTIONAL Cloudflare Turnstile secret for the waitlist + report forms.
# Empty = no verification (the forms work exactly as without Turnstile).
# Set it (plus the matching VITE_PUBLIC_TURNSTILE_SITE_KEY client var, see
# .env.example) to require a solved challenge on /api/waitlist + /api/report.
# Local testing: Cloudflare's always-passing test pair is
#   sitekey 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# In prod: echo "…" | pnpm wrangler secret put TURNSTILE_SECRET
TURNSTILE_SECRET=""

# OPTIONAL PostHog Query API credentials for the writer-stats endpoint
# (/api/stats). Both empty = the endpoint answers { enabled: false } and no
# upstream call is ever made. Set BOTH to turn it on:
# - POSTHOG_QUERY_API_KEY: a PostHog personal API key with Query Read scope
#   (prod: echo "…" | pnpm wrangler secret put POSTHOG_QUERY_API_KEY)
# - POSTHOG_PROJECT_ID: the numeric PostHog project id the pageviews live in
POSTHOG_QUERY_API_KEY=""
POSTHOG_PROJECT_ID=""
